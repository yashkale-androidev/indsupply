# Copy to .env  (cp .env.example .env)

# true  = run entirely on the built-in mock backend (src/api/mock.js). No server needed.
# false = call your real backend.
VITE_USE_MOCK=true

# Base URL of your REST API. "/api" works with the dev proxy below; in production use the full URL or a reverse proxy.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api calls (e.g. Spring Boot on 8080).
VITE_PROXY_TARGET=http://localhost:8080
